#!/bin/sh
# ask — the one line an agent types when it needs a platform:
#
#   tools/ask "a poster: last floor, 1930s algiers, 35mm, one line of type"
#   tools/ask chatgpt --mode research "primary sources on the 1932 algiers oil concessions"
#   tools/ask gemini --env local --timeout 1200 "twelve frames, no text"
#
# Two small kindnesses on top of tools/gh_bridge.py: a first word that names an installed adapter
# becomes --platform, and a first word that is not a flag becomes --prompt. Everything else is
# forwarded untouched.
#
# Where the work happens is not this script's business: gh_bridge runs it in-process when a browser
# is reachable from this machine, and queues it through git when it is not. The exit code is the
# runner's (0 ok, 2 not signed in, 3 no settled answer, 4 nothing to take, 5 environment, 7 the
# bridge itself), and stdout is one JSON document either way.
set -e
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname "$here")
py=${PYTHON:-python3}

if [ "$#" -ge 2 ]; then
    case $1 in
        -*) : ;;
        *)
            if WORD=$1 ROOT=$root "$py" -c '
import os, sys
sys.path.insert(0, os.environ["ROOT"])
from tools import adapters
names = set()
for c in adapters.catalogue([]):
    names.add(c["platform"])
    names.update(c.get("aliases") or [])
sys.exit(0 if os.environ["WORD"] in names else 1)' 2>/dev/null; then
                platform=$1
                shift
                set -- --platform "$platform" "$@"
            fi
            ;;
    esac
fi

if [ "$#" -ge 1 ]; then
    case $1 in
        -*) : ;;
        *)
            first=$1
            shift
            set -- --prompt "$first" "$@"
            ;;
    esac
fi

exec "$py" "$here/gh_bridge.py" ask "$@"
